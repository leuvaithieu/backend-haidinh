generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique
  email        String?
  pickupPoint  String?
  dropoffPoint String?
  address      String?
  note         String?
  isVip        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
}

model Route {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routePoints RoutePoint[]
  trips Trip[]
}

model RoutePoint {
  id       String @id @default(cuid())
  routeId  String
  name     String
  sequence Int

  route         Route          @relation(fields: [routeId], references: [id])
  servicePoints ServicePoint[]
  
  @@unique([routeId, sequence])
}

model ServicePoint {
  id           String @id @default(cuid())
  routePointId String
  name         String

  routePoint RoutePoint @relation(fields: [routePointId], references: [id])
}

model Vehicle {
  id String @id @default(cuid())
  licensePlate String @unique
  name String @unique
  seatCount Int
  vehicleType String
  status String @default("ACTIVE")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trips Trip[]
}

model Driver{
  id String @id @default(cuid())
  name String
  phone String @unique
  licenseNumber String @unique
  licenseClass String?
  licenseExpiry DateTime?
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripAsDriver1 Trip[] @relation("TripDriver1")
  tripAsDriver2 Trip[] @relation("TripDriver2")
}

model Assistant{
  id String @id @default(cuid())
  name String
  phone String @unique
  cccd String @unique
  status    AssistantStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripAsAssistant1 Trip[] @relation("TripAssistant1")
  tripAsAssistant2 Trip[] @relation("TripAssistant2")
}

enum AssistantStatus {
  ACTIVE
  INACTIVE
}

model User{
  id String @id @default(cuid())
  username String @unique
  password String
  name String
  phone String? @unique
  role String @default("STAFF")
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdTrips Trip[]
}

enum TripStatus{
  SCHEDULED
  DEPARTED
  AT_DESTINATION
  RETURNING
  COMPLETED
  CANCELLED
}

model Trip{
  id  String @id @default(cuid())
  routeId String
  vehicleId String

  driver1Id String
  driver2Id String

  assistant1Id String
  assistant2Id String?

  plannedDeparture DateTime
  plannedArrival DateTime?

  actualDeparture DateTime?
  actualArrival DateTime?

  status TripStatus @default(SCHEDULED)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route Route @relation(fields:[routeId], references:[id])
  vehicle Vehicle @relation(fields:[vehicleId] , references:[id])

  driver1 Driver @relation("TripDriver1", fields:[driver1Id] , references:[id])
  driver2 Driver @relation("TripDriver2", fields:[driver2Id] , references:[id])

  assistant1 Assistant @relation("TripAssistant1" , fields:[assistant1Id] , references:[id])
  assistant2 Assistant? @relation("TripAssistant2" , fields:[assistant2Id] , references:[id])

  createdBy User @relation(fields:[createdById] , references:[id])
}