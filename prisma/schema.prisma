generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique
  email        String?
  pickupPoint  String?
  dropoffPoint String?
  address      String?
  note         String?
  isVip        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bookings Booking[]
}

model RouteSegment {
  id String @id @default(cuid())

  routeId          String
  fromRoutePointId String
  toRoutePointId   String

  scheduleType          RouteScheduleType @default(NORMAL)
  travelDurationMinutes Int

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  fromRoutePoint RoutePoint @relation("RouteSegmentFrom", fields: [fromRoutePointId], references: [id], onDelete: Cascade)
  toRoutePoint   RoutePoint @relation("RouteSegmentTo", fields: [toRoutePointId], references: [id], onDelete: Cascade)

  @@unique([routeId, fromRoutePointId, toRoutePointId, scheduleType])
}

enum RouteScheduleType {
  NORMAL
  TET
}

model Route {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routePoints   RoutePoint[]
  trips         Trip[]
  routeSegments RouteSegment[]

  websiteContent RouteWebsiteContent?
}

model RoutePoint {
  id                    String  @id @default(cuid())
  routeId               String
  name                  String
  sequence              Int
  defaultTime           String?
  travelDurationMinutes Int?

  route           Route            @relation(fields: [routeId], references: [id])
  servicePoints   ServicePoint[]
  tripRoutePoints TripRoutePoint[]

  outgoingSegments RouteSegment[] @relation("RouteSegmentFrom")
  incomingSegments RouteSegment[] @relation("RouteSegmentTo")

  @@unique([routeId, sequence])
}

model ServicePoint {
  id           String @id @default(cuid())
  routePointId String
  name         String

  routePoint RoutePoint @relation(fields: [routePointId], references: [id])
}

model Vehicle {
  id           String        @id @default(cuid())
  licensePlate String        @unique
  name         String        @unique
  seatCount    Int
  vehicleType  String
  status       VehicleStatus @default(ACTIVE)

  inspectionDate   DateTime?
  inspectionExpiry DateTime?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  trips      Trip[]
  seatLayout SeatLayout?
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

model Driver {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  licenseNumber String    @unique
  licenseClass  String?
  licenseExpiry DateTime?
  status        String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripAsDriver1 Trip[] @relation("TripDriver1")
  tripAsDriver2 Trip[] @relation("TripDriver2")
}

model Assistant {
  id        String          @id @default(cuid())
  name      String
  phone     String          @unique
  cccd      String          @unique
  status    AssistantStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tripAsAssistant1 Trip[] @relation("TripAssistant1")
  tripAsAssistant2 Trip[] @relation("TripAssistant2")
}

enum AssistantStatus {
  ACTIVE
  INACTIVE
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  password String
  name     String
  phone    String? @unique
  role     String  @default("STAFF")
  status   String  @default("ACTIVE")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdTrips Trip[]
}

enum TripStatus {
  SCHEDULED
  DEPARTED
  AT_DESTINATION
  RETURNING
  COMPLETED
  CANCELLED
}

enum TripDirection {
  OUTBOUND
  RETURN
}

model Trip {
  id        String @id @default(cuid())
  routeId   String
  vehicleId String

  driver1Id String
  driver2Id String

  assistant1Id String
  assistant2Id String?

  plannedDeparture       DateTime
  returnPlannedDeparture DateTime?
  plannedArrival         DateTime?
  ticketPrice            Int       @default(0)

  tripRoutePoints TripRoutePoint[]

  actualDeparture DateTime?
  actualArrival   DateTime?

  status       TripStatus        @default(SCHEDULED)
  scheduleType RouteScheduleType @default(NORMAL)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route   Route   @relation(fields: [routeId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  driver1 Driver @relation("TripDriver1", fields: [driver1Id], references: [id])
  driver2 Driver @relation("TripDriver2", fields: [driver2Id], references: [id])

  assistant1 Assistant  @relation("TripAssistant1", fields: [assistant1Id], references: [id])
  assistant2 Assistant? @relation("TripAssistant2", fields: [assistant2Id], references: [id])

  createdBy User @relation(fields: [createdById], references: [id])

  bookings  Booking[]
  tripSeats TripSeat[]
}

model TripRoutePoint {
  id           String        @id @default(cuid())
  tripId       String
  routePointId String?
  pointName    String
  direction    TripDirection
  sequence     Int
  plannedTime  DateTime
  actualTime   DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  routePoint RoutePoint? @relation(fields: [routePointId], references: [id], onDelete: SetNull)

  @@unique([tripId, direction, sequence])
  @@index([tripId, direction])
}

enum CmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String    @db.Text
  coverImage     String?
  category       String?
  tags           String[]  @default([])
  status         CmsStatus @default(DRAFT)
  featured       Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, publishedAt])
}

model RouteWebsiteContent {
  id      String @id @default(cuid())
  routeId String @unique

  title            String
  slug             String  @unique
  shortDescription String?
  description      String?

  imageUrl  String?
  bannerUrl String?

  isPublished  Boolean @default(false)
  displayOrder Int     @default(0)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

enum SeatType {
  BERTH
  SEAT
  PRIVATE_ROOM
  OTHER
}

enum SeatLayoutStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model SeatLayout {
  id          String           @id @default(cuid())
  name        String
  description String?
  status      SeatLayoutStatus @default(DRAFT)

  // true: sơ đồ mẫu; false: sơ đồ của xe thực tế
  isTemplate Boolean @default(false)

  // Sơ đồ của xe thực tế có vehicleId.
  // Sơ đồ mẫu không cần vehicleId.
  vehicleId String?  @unique
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // Ghi nhận sơ đồ nguồn khi sao chép mẫu
  copiedFromId String?
  copiedFrom   SeatLayout?  @relation("SeatLayoutCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       SeatLayout[] @relation("SeatLayoutCopies")

  seats Seat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isTemplate, status])
  @@index([copiedFromId])
}

model Seat {
  id       String     @id @default(cuid())
  layoutId String
  layout   SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  code  String
  label String?
  type  SeatType @default(BERTH)

  // Tầng và vị trí hiển thị trên sơ đồ
  level  Int @default(1)
  row    Int
  column Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trạng thái ghế theo từng chuyến
  tripSeats TripSeat[]

  @@unique([layoutId, code])
  @@unique([layoutId, level, row, column])
  @@index([layoutId, isActive])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Booking {
  id String @id @default(cuid())

  bookingCode String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  customerName  String
  customerPhone String
  customerEmail String?

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  totalAmount   Int @default(0)
  depositAmount Int @default(0)
  paidAmount    Int @default(0)

  holdExpiresAt DateTime?

  seats BookingSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, status])
  @@index([customerPhone])
  @@index([holdExpiresAt])
}

model BookingSeat {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  tripSeatId String
  tripSeat   TripSeat @relation(fields: [tripSeatId], references: [id], onDelete: Restrict)

  price Int

  createdAt DateTime @default(now())

  @@unique([bookingId, tripSeatId])
  @@index([tripSeatId])
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

model TripSeat {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  seatId String
  seat   Seat   @relation(fields: [seatId], references: [id], onDelete: Restrict)

  status          TripSeatStatus @default(AVAILABLE)
  holdExpiresAt   DateTime?
  heldByBookingId String?

  bookingSeats BookingSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, seatId])
  @@index([tripId, status])
  @@index([holdExpiresAt])
  @@index([heldByBookingId])
}
