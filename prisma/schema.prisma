generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Nơi khai báo enum
enum RouteScheduleType {
  NORMAL
  TET
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum AssistantStatus {
  ACTIVE
  INACTIVE
}

enum TripStatus {
  SCHEDULED
  DEPARTED
  AT_DESTINATION
  RETURNING
  COMPLETED
  CANCELLED
}

enum TripDirection {
  OUTBOUND
  RETURN
}

enum CmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SeatType {
  BERTH
  SEAT
  PRIVATE_ROOM
  OTHER
}

enum SeatLayoutStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BookingStatus {
  PENDING
  PAYMENT_REVIEW
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PENDING
  REPORTED
  PARTIALLY_PAID
  PAID
  FAILED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum PricePolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PriceEntryType {
  FIXED
  CONTACT
}

enum PricePointType {
  ROUTE_POINT
  SERVICE_POINT
}

enum SeatAllocationStatus {
  HELD
  BOOKED
  RELEASED
  EXPIRED
}

//Khai báo các model
model Customer {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique
  email        String?
  pickupPoint  String?
  dropoffPoint String?
  address      String?
  note         String?
  isVip        Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bookings Booking[]
}

model RouteSegment {
  id String @id @default(cuid())

  routeId          String
  fromRoutePointId String
  toRoutePointId   String

  scheduleType          RouteScheduleType @default(NORMAL)
  travelDurationMinutes Int

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  fromRoutePoint RoutePoint @relation("RouteSegmentFrom", fields: [fromRoutePointId], references: [id], onDelete: Cascade)
  toRoutePoint   RoutePoint @relation("RouteSegmentTo", fields: [toRoutePointId], references: [id], onDelete: Cascade)

  @@unique([routeId, fromRoutePointId, toRoutePointId, scheduleType])
}

model Route {
  id   String @id @default(cuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routePoints   RoutePoint[]
  trips         Trip[]
  routeSegments RouteSegment[]

  websiteContent RouteWebsiteContent?

  pricePolicies RoutePricePolicy[]
}

model RoutePoint {
  id                    String  @id @default(cuid())
  routeId               String
  name                  String
  sequence              Int
  defaultTime           String?
  travelDurationMinutes Int?

  route           Route            @relation(fields: [routeId], references: [id])
  servicePoints   ServicePoint[]
  tripRoutePoints TripRoutePoint[]

  outgoingSegments RouteSegment[] @relation("RouteSegmentFrom")
  incomingSegments RouteSegment[] @relation("RouteSegmentTo")

  baseForPricePolicies RoutePricePolicy[] @relation("PricePolicyBaseOrigin")

  routePointPrices RoutePointPrice[]

  priceOverridesFrom RoutePriceOverride[] @relation("PriceOverrideFromRoutePoint")
  priceOverridesTo   RoutePriceOverride[] @relation("PriceOverrideToRoutePoint")

  bookingPickups  BookingSeat[] @relation("BookingSeatPickupRoutePoint")
  bookingDropoffs BookingSeat[] @relation("BookingSeatDropoffRoutePoint")

  @@unique([routeId, sequence])
}

model ServicePoint {
  id           String @id @default(cuid())
  routePointId String
  name         String

  routePoint RoutePoint @relation(fields: [routePointId], references: [id])

  servicePointPrices ServicePointPrice[]

  priceOverridesFrom RoutePriceOverride[] @relation("PriceOverrideFromServicePoint")
  priceOverridesTo   RoutePriceOverride[] @relation("PriceOverrideToServicePoint")

  bookingPickups  BookingSeat[] @relation("BookingSeatPickupServicePoint")
  bookingDropoffs BookingSeat[] @relation("BookingSeatDropoffServicePoint")
}

model Vehicle {
  id           String        @id @default(cuid())
  licensePlate String        @unique
  name         String        @unique
  seatCount    Int
  vehicleType  String
  status       VehicleStatus @default(ACTIVE)

  inspectionDate   DateTime?
  inspectionExpiry DateTime?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  trips      Trip[]
  seatLayout SeatLayout?
}

model Driver {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  licenseNumber String    @unique
  licenseClass  String?
  licenseExpiry DateTime?
  status        String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tripAsDriver1 Trip[] @relation("TripDriver1")
  tripAsDriver2 Trip[] @relation("TripDriver2")
}

model Assistant {
  id        String          @id @default(cuid())
  name      String
  phone     String          @unique
  cccd      String          @unique
  status    AssistantStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tripAsAssistant1 Trip[] @relation("TripAssistant1")
  tripAsAssistant2 Trip[] @relation("TripAssistant2")
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  password String
  name     String
  phone    String? @unique
  role     String  @default("STAFF")
  status   String  @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTrips Trip[]

  confirmedPayments Payment[] @relation("PaymentConfirmedBy")
}

model Trip {
  id        String @id @default(cuid())
  routeId   String
  vehicleId String

  driver1Id String
  driver2Id String

  assistant1Id String
  assistant2Id String?

  plannedDeparture       DateTime
  returnPlannedDeparture DateTime?
  plannedArrival         DateTime?
  ticketPrice            Int       @default(0)

  tripRoutePoints TripRoutePoint[]

  actualDeparture DateTime?
  actualArrival   DateTime?

  status       TripStatus        @default(SCHEDULED)
  scheduleType RouteScheduleType @default(NORMAL)

  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route   Route   @relation(fields: [routeId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  driver1 Driver @relation("TripDriver1", fields: [driver1Id], references: [id])
  driver2 Driver @relation("TripDriver2", fields: [driver2Id], references: [id])

  assistant1 Assistant  @relation("TripAssistant1", fields: [assistant1Id], references: [id])
  assistant2 Assistant? @relation("TripAssistant2", fields: [assistant2Id], references: [id])

  createdBy User @relation(fields: [createdById], references: [id])

  bookings  Booking[]
  tripSeats TripSeat[]
}

model TripRoutePoint {
  id           String        @id @default(cuid())
  tripId       String
  routePointId String?
  pointName    String
  direction    TripDirection
  sequence     Int
  plannedTime  DateTime
  actualTime   DateTime?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  routePoint RoutePoint? @relation(fields: [routePointId], references: [id], onDelete: SetNull)

  bookingPickups  BookingSeat[] @relation("BookingSeatPickupTripRoutePoint")
  bookingDropoffs BookingSeat[] @relation("BookingSeatDropoffTripRoutePoint")

  @@unique([tripId, direction, sequence])
  @@index([tripId, direction])
}

model Article {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String    @db.Text
  coverImage     String?
  category       String?
  tags           String[]  @default([])
  status         CmsStatus @default(DRAFT)
  featured       Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, publishedAt])
}

model RouteWebsiteContent {
  id      String @id @default(cuid())
  routeId String @unique

  title            String
  slug             String  @unique
  shortDescription String?
  description      String?

  imageUrl  String?
  bannerUrl String?

  isPublished  Boolean @default(false)
  displayOrder Int     @default(0)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

model SeatLayout {
  id          String           @id @default(cuid())
  name        String
  description String?
  status      SeatLayoutStatus @default(DRAFT)

  // true: sơ đồ mẫu; false: sơ đồ của xe thực tế
  isTemplate Boolean @default(false)

  // Sơ đồ của xe thực tế có vehicleId.
  // Sơ đồ mẫu không cần vehicleId.
  vehicleId String?  @unique
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  // Ghi nhận sơ đồ nguồn khi sao chép mẫu
  copiedFromId String?
  copiedFrom   SeatLayout?  @relation("SeatLayoutCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       SeatLayout[] @relation("SeatLayoutCopies")

  seats Seat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isTemplate, status])
  @@index([copiedFromId])
}

model Seat {
  id       String     @id @default(cuid())
  layoutId String
  layout   SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  code  String
  label String?
  type  SeatType @default(BERTH)

  // Tầng và vị trí hiển thị trên sơ đồ
  level  Int @default(1)
  row    Int
  column Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trạng thái ghế theo từng chuyến
  tripSeats TripSeat[]

  @@unique([layoutId, code])
  @@unique([layoutId, level, row, column])
  @@index([layoutId, isActive])
}

model Booking {
  id String @id @default(cuid())

  bookingCode String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  customerName  String
  customerPhone String
  customerEmail String?

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  payments Payment[]

  direction TripDirection @default(OUTBOUND)

  totalAmount   Int @default(0)
  depositAmount Int @default(0)
  paidAmount    Int @default(0)

  holdExpiresAt DateTime?

  seats BookingSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, status])
  @@index([customerPhone])
  @@index([holdExpiresAt])
}

model BookingSeat {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  // Liên kết với lần phân bổ ghế trên chuyến.
  seatAllocationId String         @unique
  seatAllocation   SeatAllocation @relation(fields: [seatAllocationId], references: [id], onDelete: Restrict)

  price Int

  // Điểm đón và trả theo dữ liệu tuyến gốc.
  pickupRoutePointId String?
  pickupRoutePoint   RoutePoint? @relation("BookingSeatPickupRoutePoint", fields: [pickupRoutePointId], references: [id], onDelete: SetNull)

  dropoffRoutePointId String?
  dropoffRoutePoint   RoutePoint? @relation("BookingSeatDropoffRoutePoint", fields: [dropoffRoutePointId], references: [id], onDelete: SetNull)

  pickupServicePointId String?
  pickupServicePoint   ServicePoint? @relation("BookingSeatPickupServicePoint", fields: [pickupServicePointId], references: [id], onDelete: SetNull)

  dropoffServicePointId String?
  dropoffServicePoint   ServicePoint? @relation("BookingSeatDropoffServicePoint", fields: [dropoffServicePointId], references: [id], onDelete: SetNull)

  // Điểm đón và trả thực tế trong lịch trình của chuyến.
  pickupTripRoutePointId String?
  pickupTripRoutePoint   TripRoutePoint? @relation("BookingSeatPickupTripRoutePoint", fields: [pickupTripRoutePointId], references: [id], onDelete: Restrict)

  dropoffTripRoutePointId String?
  dropoffTripRoutePoint   TripRoutePoint? @relation("BookingSeatDropoffTripRoutePoint", fields: [dropoffTripRoutePointId], references: [id], onDelete: Restrict)

  pricePolicyId String?
  pricePolicy   RoutePricePolicy? @relation(fields: [pricePolicyId], references: [id], onDelete: Restrict)

  // Lưu lại giá và phụ phí tại thời điểm khách đặt vé.
  priceSnapshot Json?

  passengerName  String?
  passengerPhone String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([pricePolicyId])
}

model Payment {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  amount Int

  method PaymentMethod @default(BANK_TRANSFER)
  status PaymentStatus @default(PENDING)

  // Mã giao dịch ngân hàng
  transactionCode String?

  // Nội dung chuyển khoản
  transferContent String?

  // Thời điểm khách báo đã chuyển khoản
  reportedAt DateTime?

  // Thời điểm nhân viên xác nhận
  confirmedAt DateTime?

  // Nhân viên xác nhận giao dịch
  confirmedById String?
  confirmedBy   User?   @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Lý do từ chối giao dịch
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([transactionCode])
}

model TripSeat {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Restrict)

  seatId String
  seat   Seat   @relation(fields: [seatId], references: [id], onDelete: Restrict)

  status          TripSeatStatus @default(AVAILABLE)
  holdExpiresAt   DateTime?
  heldByBookingId String?

  seatAllocations SeatAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, seatId])
  @@index([tripId, status])
  @@index([holdExpiresAt])
  @@index([heldByBookingId])
}

model SystemSetting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model RoutePricePolicy {
  id String @id @default(cuid())

  routeId String
  route   Route @relation(fields: [routeId], references: [id], onDelete: Restrict)

  // Chế độ giá NORMAL hoặc TET.
  pricingMode RouteScheduleType @default(NORMAL)

  // Điểm xuất phát gốc, chỉ sử dụng cho NORMAL.
  baseOriginRoutePointId String?
  baseOriginRoutePoint RoutePoint? @relation("PricePolicyBaseOrigin", fields: [baseOriginRoutePointId], references: [id], onDelete: Restrict)

  // Chiều áp dụng chính sách.
  direction TripDirection

  // null: áp dụng chung mọi loại xe.
  // Có giá trị: áp dụng riêng cho loại xe đó.
  vehicleType String?

  // Phiên bản chính sách trong cùng phạm vi.
  version Int @default(1)

  status PricePolicyStatus @default(DRAFT)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  // Giá toàn tuyến, chỉ sử dụng cho TET.
  fullRoutePrice Int?

  // Điều chỉnh cố định giá tuyến, chỉ sử dụng cho NORMAL.
  routeAdjustmentAmount Int @default(0)

  routePointPrices   RoutePointPrice[]
  servicePointPrices ServicePointPrice[]
  priceOverrides     RoutePriceOverride[]

  bookingSeats BookingSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([routeId, pricingMode, direction, status])
  @@index([routeId, vehicleType, effectiveFrom, effectiveTo])
  @@index([routeId, pricingMode, direction, version])
}


//Giá theo RoutePoint

model RoutePointPrice {
  id String @id @default(cuid())

  policyId String
  policy RoutePricePolicy @relation(fields: [policyId],references: [id], onDelete: Cascade)

  routePointId String
  routePoint RoutePoint @relation(fields: [routePointId], references: [id], onDelete: Restrict)

  priceType PriceEntryType @default(CONTACT)
  price Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([policyId, routePointId])
  @@index([routePointId])
}


//Giá theo servicepoint

model ServicePointPrice {
  id String @id @default(cuid())

  policyId String
  policy RoutePricePolicy @relation( fields: [policyId], references: [id], onDelete: Cascade)

  servicePointId String
  servicePoint ServicePoint @relation( fields: [servicePointId], references: [id], onDelete: Restrict)

  priceType PriceEntryType @default(CONTACT)
  price Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([policyId, servicePointId])
  @@index([servicePointId])
}


//Giá theo cặp điểm lên - xuống

model RoutePriceOverride {
  id String @id @default(cuid())

  policyId String
  policy RoutePricePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  fromPointType PricePointType
  toPointType PricePointType

  // RP:<id> hoặc SP:<id>.
  // Dùng key để xác định duy nhất cặp điểm.
  fromPointKey String
  toPointKey String

  fromRoutePointId String?
  fromRoutePoint RoutePoint? @relation("PriceOverrideFromRoutePoint", fields: [fromRoutePointId], references: [id], onDelete: Restrict)

  fromServicePointId String?
  fromServicePoint ServicePoint? @relation( "PriceOverrideFromServicePoint", fields: [fromServicePointId], references: [id], onDelete: Restrict)

  toRoutePointId String?
  toRoutePoint RoutePoint? @relation( "PriceOverrideToRoutePoint", fields: [toRoutePointId], references: [id], onDelete: Restrict)

  toServicePointId String?
  toServicePoint ServicePoint? @relation("PriceOverrideToServicePoint", fields: [toServicePointId], references: [id], onDelete: Restrict)

  priceType PriceEntryType @default(CONTACT)
  price Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([policyId, fromPointKey, toPointKey])
  @@index([policyId])
}


model SeatAllocation {
  id String @id @default(cuid())

  tripSeatId String
  tripSeat   TripSeat @relation(fields: [tripSeatId], references: [id], onDelete: Restrict)

  // Chiều chạy của ghế.
  direction TripDirection

  // Khoảng đường ghế được sử dụng: pickupSequence -> dropoffSequence.
  pickupSequence  Int
  dropoffSequence Int

  // HELD: đang giữ chỗ; BOOKED: đã xác nhận.
  // RELEASED: đã giải phóng; EXPIRED: hết hạn giữ chỗ.
  status SeatAllocationStatus @default(HELD)

  holdExpiresAt DateTime?

  bookingSeat BookingSeat?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripSeatId, direction, status])
  @@index([holdExpiresAt])
}
